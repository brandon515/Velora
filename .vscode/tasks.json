{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "type": "shell",
      "label": "Configure",
      "detail": "meson setup builddir (run once, or after changing meson options)",
      "command": "meson setup builddir --reconfigure",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Configure (ASan/UBSan)",
      "detail": "Sanitizer build in build-asan, matching CI's sanitize job",
      "command": "meson setup build-asan -Dbuildtype=debug -Db_sanitize=address,undefined -Db_lundef=false --reconfigure",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Build",
      "detail": "Compile every target in builddir",
      "command": "meson compile -C builddir",
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["relative", "${workspaceFolder}/builddir"]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Install to bin",
      "detail": "Build, then copy engine, lib_test, shaders and libraries into bin/ for the launch configurations",
      "command": "meson install -C builddir",
      "dependsOn": "Build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "type": "shell",
      "label": "Run tests",
      "detail": "Build velora_tests and run every suite",
      "command": "meson test -C builddir --print-errorlogs",
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["relative", "${workspaceFolder}/builddir"]
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Run tests (ASan/UBSan)",
      "detail": "Run every suite in the sanitizer build. Run 'Configure (ASan/UBSan)' first",
      "command": "meson test -C build-asan --print-errorlogs",
      "options": {
        "env": {
          "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
          "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
        }
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["relative", "${workspaceFolder}/build-asan"]
      },
      "group": "test"
    },
    {
      "type": "shell",
      "label": "Run test suite",
      "detail": "Run one suite and print each check",
      "command": "meson compile -C builddir velora_tests && ./builddir/src/binaries/testing/velora_tests ${input:testSuite}",
      "windows": {
        "command": "meson compile -C builddir velora_tests; if ($?) { .\\builddir\\src\\binaries\\testing\\velora_tests.exe ${input:testSuite} }"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ],
  "inputs": [
    {
      "id": "testSuite",
      "type": "pickString",
      "description": "Test suite to run",
      "options": [
        "vmemory", "darray", "map", "event", "vstring", "vmath",
        "vfile", "vjson", "vgltf", "logger", "platform", "ecs"
      ]
    }
  ]
}
