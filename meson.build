project('Velora', 'c', 'cpp')

add_project_arguments('-D_DEBUG', language: 'c')
add_project_arguments('-DVULKAN_RENDER', language: 'c')
add_project_arguments('-D_CRT_SECURE_NO_WARNINGS', language: 'c')
add_project_arguments('-D_FILE_OFFSET_BITS=64', language: 'c')

subdir('src')

# Library headers belong in src/common/, never src/libraries/. Runs in CI with
# the unit tests and needs nothing built.
test('header-layout', find_program('tools/check_header_layout.py'),
  args: [meson.project_source_root()])

# The game's default model and the renderer's fallback texture, generated by
# tools/make_cube_assets.py. Installed next to the engine, which loads them
# from its working directory.
install_data(
  files('assets/Cube.gltf', 'assets/Cube.bin', 'assets/Cube_BaseColor.png',
        'assets/Cube_MetallicRoughness.png', 'assets/DefaultTexture.png'),
  install_dir: meson.project_source_root() / 'bin'
)
